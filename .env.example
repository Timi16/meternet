# Copy to .env and fill in. Never commit .env, node keys or passwords.

# FNN (box node). FNN encrypts <data dir>/ckb/key with this password on first start.
FIBER_SECRET_KEY_PASSWORD=

# meterd
BOX_RPC=http://127.0.0.1:8227
# Per-box secret for hashing device IDs in logs. Generate with: openssl rand -hex 16
DEVICE_SALT=
# Price of one 2 MB chunk in shannons (1 CKB = 100000000). Default 0.1 CKB.
CHUNK_PRICE_SHANNONS=10000000
LOG_DIR=./logs

# Local testnet e2e only (scripts/testnet-e2e.ts): the stand-in payer node
PAYER_RPC=http://127.0.0.1:8237
BOX_P2P_ADDR=
FUNDING_CKB=200
