# Copy to .env and fill in. Never commit .env, node keys or passwords.

# FNN (box node). FNN encrypts <data dir>/ckb/key with this password on first start.
FIBER_SECRET_KEY_PASSWORD=

# meterd
BOX_RPC=http://127.0.0.1:8227
# Per-box secret for hashing device IDs in logs. Generate with: openssl rand -hex 16
DEVICE_SALT=
# Price of one 2 MB chunk in shannons (1 CKB = 100000000). Default 0.1 CKB.
CHUNK_PRICE_SHANNONS=10000000
LOG_DIR=./logs

# meterd web MVP (src/main.ts): gateway content and HTTP listener
CONTENT_DIR=./content
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8300
# Abuse limits (defaults shown): sessions in total and per client address,
# new sessions per address per minute, bytes per session, bytes/s per session,
# idle time before a session ends, how long a cut session stays queryable.
MAX_SESSIONS=50
MAX_SESSIONS_PER_IP=3
NEW_SESSIONS_PER_IP_PER_MIN=10
SESSION_MAX_BYTES=104857600
SESSION_BYTES_PER_SEC=262144
IDLE_END_MS=600000
CUT_RETAIN_MS=120000

# Local testnet e2e only (scripts/testnet-e2e.ts): the stand-in payer node
PAYER_RPC=http://127.0.0.1:8237
BOX_P2P_ADDR=
FUNDING_CKB=200
