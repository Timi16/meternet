# The hotspot box's settings for `docker compose up` (docker-compose.yml).
# Copy to box/box.env and fill in; box/box.env is ignored by git.
# (The DuckDNS token stays in box/.env, used only by box/certs.sh, so no
# container ever sees it.)

# The box's name: your DuckDNS domain, with a certificate in box/certs
# (box/certs.sh). Phones open https://BOX_FQDN.
BOX_FQDN=meternet-box1.duckdns.org

# The laptop's Wi-Fi interface (ip link), and the hotspot address on it.
# The DuckDNS record should point at this address too.
GATEWAY_IFACE=wlan0
BOX_LAN_IP=192.168.2.1

# Hashes MACs into the device IDs in the logs. Make one with:
#   openssl rand -hex 32
# and keep it: changing it changes every device ID.
DEVICE_SALT=

# Optional. Price of each 2 MB chunk in shannons (1 CKB = 100000000).
# CHUNK_PRICE_SHANNONS=10000000

# Optional, for the Wi-Fi profile: country code for the radio (e.g. NG, GB),
# channel and network name.
# WIFI_COUNTRY=NG
# WIFI_CHANNEL=6
# WIFI_SSID=MeterNet-demo
