# Copy to box/.env and fill in. box/.env is ignored by git: never commit it,
# and never paste the token into chat or an issue.

# DuckDNS (https://www.duckdns.org): the box's name, and the token from the
# top of your DuckDNS page. Used only to set the TXT record for the free
# Let's Encrypt certificate (DNS-01), so the phone's wallet gets HTTPS.
DUCKDNS_DOMAIN=meternet-box1
DUCKDNS_TOKEN=

# The hotspot address phones reach the box at. macOS Internet Sharing uses
# 192.168.2.1; the Linux box (box/linux) uses its own.
BOX_LAN_IP=192.168.2.1
